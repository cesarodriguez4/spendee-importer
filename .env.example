# Copy to .env (gitignored) and fill in. Never commit real values.

# REST API: imports. https://web.budgetbakers.com/settings/rest-api (Premium plan)
WALLET_API_KEY=
# Optional. Root path before /v1/api.
WALLET_API_URL=https://rest.budgetbakers.com/wallet

# MCP: questions from agents. A separate token from https://web.budgetbakers.com/settings/mcp-server
WALLET_MCP_TOKEN=

# Board (Celssica LLC): the business version of Wallet, with its own tokens.
# REST API: https://web-board.budgetbakers.com/settings/rest-api (Premium plan)
BOARD_API_KEY=
# Optional. Root path before /v1/api.
BOARD_API_URL=https://rest.budgetbakers.com/board
# MCP: questions from agents. A separate token from Board's settings.
BOARD_MCP_TOKEN=
# Optional. Defaults to board-accounts.json (see board-accounts.example.json).
BOARD_ACCOUNTS_PATH=

# Discord channel for wallet importer notifications
DISCORD_WALLET_CONVERSATION_REF=

# Screenshots: either a Drive folder...
SCREENSHOTS_DRIVE_FOLDER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# ...or a folder the agent can already reach on disk.
SCREENSHOTS_DIR=
